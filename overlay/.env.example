# =============================================================================
# kb 二次开发环境变量样例（.env.example）
# 作者：张彦龙
#
# 基于官方 docker/.env 的键裁剪而来。用法：
#   cp overlay/.env.example docker/.env
# 然后按需修改。真实密钥不要提交到仓库！
# 官方完整键列表以 docker/.env 为准，此处只列出二次开发常用项。
# =============================================================================

# ------------------------------
# 基础组件选型（保持官方默认即可）
# ------------------------------
# 文档引擎：elasticsearch（默认）/ infinity / opensearch 等
DOC_ENGINE=${DOC_ENGINE:-elasticsearch}
# 元数据库：mysql（默认）/ postgres 等
DB_TYPE=${DB_TYPE:-mysql}
# deepdoc 推理设备：cpu（默认）/ gpu
DEVICE=${DEVICE:-cpu}
COMPOSE_PROFILES=${DOC_ENGINE},${DEVICE},metadata-mysql

# ------------------------------
# 中间件密码（生产环境务必全部改为强密码，可用 openssl rand -hex 32 生成）
# ------------------------------
ELASTIC_PASSWORD=infini_rag_flow
MYSQL_PASSWORD=infini_rag_flow
MINIO_USER=rag_flow
MINIO_PASSWORD=infini_rag_flow
REDIS_PASSWORD=infini_rag_flow

# 单个容器内存上限（字节），按宿主机内存调整
MEM_LIMIT=8073741824

# ------------------------------
# 服务端口
# ------------------------------
SVR_WEB_HTTP_PORT=80
SVR_WEB_HTTPS_PORT=443
# HTTP API 端口（外部集成、ragflow_sdk 均走此端口）
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
# MCP 端口（需在 compose 中启用 --enable-mcpserver 后生效）
SVR_MCP_PORT=9382

# ------------------------------
# RAGFlow 镜像（与 docs/SECONDARY.md 的部署基线保持一致）
# v0.22+ 镜像不再内置 embedding 模型
# ------------------------------
RAGFLOW_IMAGE=infiniflow/ragflow:v0.26.4
# 国内网络可改用镜像仓库：
# RAGFLOW_IMAGE=registry.cn-hangzhou.aliyuncs.com/infiniflow/ragflow:v0.26.4
# RAGFLOW_IMAGE=swr.cn-north-4.myhuaweicloud.com/infiniflow/ragflow:v0.26.4

# 时区
TZ=Asia/Shanghai

# huggingface.co 访问受限时取消注释：
# HF_ENDPOINT=https://hf-mirror.com

# 注册开关（1 开启 / 0 关闭）
REGISTER_ENABLED=1

# =============================================================================
# 模型接入说明（kb 定制备注）
#
# RAGFlow 的 LLM / embedding 模型主要通过管理界面「模型提供商」页面配置，
# 或通过 conf/service_conf.yaml 的 user_default_llm 设定默认值；
# 以下变量仅作为部署时的记录与脚本引用，官方 compose 并不直接消费它们。
# =============================================================================

# --- OpenAI 兼容接口（OpenAI-API-Compatible 提供商）---
# 适用于任何兼容 /v1/chat/completions 的自建或第三方网关
# KB_LLM_BASE_URL=https://your-gateway.example.com/v1
# KB_LLM_API_KEY=sk-xxxxxxxx
# KB_LLM_MODEL=your-model-name

# --- Ollama（本地模型）---
# 容器内访问宿主机 Ollama 时使用 http://host.docker.internal:11434
# KB_OLLAMA_BASE_URL=http://host.docker.internal:11434
# KB_OLLAMA_MODEL=qwen2.5:7b

# --- DashScope / 通义千问（Tongyi-Qianwen 提供商）---
# KB_DASHSCOPE_API_KEY=sk-xxxxxxxx
# KB_DASHSCOPE_MODEL=qwen-plus

# --- Embedding 模型 ---
# 中文场景默认推荐 BAAI/bge-large-zh-v1.5（可通过 OpenAI 兼容接口、
# Ollama 或独立 TEI 服务提供）。如启用官方 TEI profile，可设置：
# TEI_MODEL=BAAI/bge-large-zh-v1.5
# COMPOSE_PROFILES=${COMPOSE_PROFILES},tei-cpu
