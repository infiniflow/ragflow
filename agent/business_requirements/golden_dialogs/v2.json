  "cases": [
    {
      "id": "G01_minimal_idea_requires_intake",
      "priority": "P0",
      "category": "positive",
      "turns": [
        {
          "role": "author",
          "text": "Нужен сервис записи клиентов в отделение."
        }
      ],
      "assertions": [
        "lifecycle_state=INTAKE",
        "no_revision_created",
        "questions_count_between_2_and_4",
        "every_question_has_2_to_4_options"
      ]
    },
    {
      "id": "G02_complete_intake_creates_draft",
      "priority": "P0",
      "category": "positive",
      "turns": [
        {
          "role": "author",
          "text": "Нужна запись в отделение для физлиц Москвы."
        },
        {
          "role": "author",
          "text": "Пик 500 одновременных пользователей, доступность 99,9%, метрики: созданные, отмененные и просроченные записи. Участники: мобильное приложение, booking-service и CRM. НПА не применяются."
        }
      ],
      "assertions": [
        "lifecycle_state=REVIEW",
        "revision_number=1",
        "template_section_order_exact",
        "section_5_5_not_empty",
        "protocol_not_embedded_in_body"
      ]
    },
    {
      "id": "G03_numbered_answer",
      "priority": "P0",
      "category": "positive",
      "turns": [
        {
          "role": "agent",
          "text": "Какая география? 1. Москва 2. РФ 3. Пилотный регион"
        },
        {
          "role": "author",
          "text": "2"
        }
      ],
      "assertions": [
        "answer_resolves_option_2",
        "answer_event_is_append_only",
        "question_is_closed"
      ]
    },
